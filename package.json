{
  "name": "xuper-tv-desktop",
  "version": "1.3.0",
  "private": true,
  "description": "XUPER TV+ para Windows, macOS y Linux",
  "author": "cristianco7",
  "license": "SEE LICENSE IN LICENSE",
  "main": "desktop/main.cjs",
  "productName": "XUPER TV+",
  "scripts": {
    "build:linux": "electron-builder --linux --x64"
  },
  "build": {
    "appId": "com.xuptertv.desktop",
    "productName": "XUPER TV Plus",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "desktop/**/*",
      "server/**/*",
      "vendor/**/*",
      "public/**/*",
      "package.json",
      "LICENSE",
      "THIRD_PARTY.md",
      "!**/*.backup",
      "!**/*.map",
      "LICENSE-LINUX"
    ],
    "linux": {
      "target": [
        "deb",
        "AppImage"
      ],
      "category": "AudioVideo",
      "synopsis": "Aplicación de televisión y contenido multimedia",
      "description": "Aplicación de escritorio XUPER TV+.",
      "maintainer": "XUPER TV+",
      "syncDesktopName": true,
      "icon": "build/icon.png"
    },
    "deb": {
      "depends": [
        "ffmpeg"
      ],
      "priority": "optional",
      "afterInstall": "build/after-install.sh"
    },
    "artifactName": "xuper-tv-plus_${version}_${arch}.${ext}"
  },
  "devDependencies": {
    "electron": "^45.2.2",
    "electron-builder": "^26.18.0"
  },
  "homepage": "https://93123cce.xupertvplus-respaldo.pages.dev/",
  "contributors": [
    {
      "name": "Cristian David Giraldo",
      "contribution": "Linux port, Electron adaptation, packaging and build scripts"
    }
  ]
}
